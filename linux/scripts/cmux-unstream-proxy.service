# systemd USER unit for the unstream proxy — see linux/scripts/unstream-proxy.py
# and docs/linux-port/UPSTREAM.md §5d for why it exists.
#
# Install (or re-install after editing):
#   mkdir -p ~/.config/systemd/user
#   cp linux/scripts/cmux-unstream-proxy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cmux-unstream-proxy
#
# Change the upstream or port without editing this file:
#   systemctl --user edit cmux-unstream-proxy      # drop-in with a new ExecStart
#
# Remove when the operator restores streaming — that is the point of it:
#   systemctl --user disable --now cmux-unstream-proxy

[Unit]
Description=cmux unstream proxy (SSE shim for a non-streaming upstream)
Documentation=file:///home/hias/cmux/docs/linux-port/UPSTREAM.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/cmux/linux/scripts/unstream-proxy.py https://chat.s.regio-ai.eu/api/v1 8480
Restart=on-failure
RestartSec=5
# It proxies an API key it never stores: the client's Authorization header
# is forwarded, nothing is written to disk, so the unit needs no secrets.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Loopback only; the proxy binds 127.0.0.1 itself.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
